{
  "buildCommand": "node scripts/build.cjs",
  "outputDirectory": "dist",
  "functions": {
    "api/os/voz.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/versao.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/acompanhar/:token",
      "destination": "/acompanhar.html"
    },
    {
      "source": "/pedido/:loja",
      "destination": "/pedido.html"
    },
    {
      "source": "/pedido",
      "destination": "/pedido.html"
    },
    {
      "source": "/vitrine/:loja",
      "destination": "/vitrine.html"
    },
    {
      "source": "/vitrine",
      "destination": "/vitrine.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
