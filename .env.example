# Copie para .env (local) ou cadastre na Vercel (Settings → Environment Variables).
# NUNCA coloque valores reais neste arquivo.

# --- App (front) ---
# Supabase da Oficina Simples. A chave publishable/anon é pública por natureza (a segurança é a RLS).
# Em produção as três são obrigatórias (sem elas a publicação para com erro).
# Em Preview (branches), sem elas o app abre em modo local (sem banco).
OFICINA_SUPABASE_URL=
OFICINA_SUPABASE_ANON_KEY=
# Repita aqui a mesma URL acima, só em Production (trava contra usar o banco de teste em produção)
OFICINA_CONFIRMO_BANCO_PRODUCAO=
# Domínio principal (ex.: seudominio.com.br). Cada oficina fica em <endereço>.seudominio.com.br
OFICINA_DOMINIO=

# --- Servidor (funções em /api) ---
# Chave secreta do Supabase: cadastre SÓ na Vercel, nunca no código nem no chat.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Pagamento (produto novo da Kiwify)
KIWIFY_WEBHOOK_TOKEN=
# Preencher OS por voz (Google Gemini). A chave vem do Google AI Studio. Modelo vazio = o Gemini Flash mais recente
GEMINI_API_KEY=
GEMINI_MODEL=
# E-mails (Brevo, com domínio verificado)
BREVO_API_KEY=
BREVO_REMETENTE=
PLATAFORMA_NOME=Oficina Simples
# Endereço do app, usado no link do e-mail de boas-vindas (ex.: https://app.seudominio.com.br)
SITE_URL=
